PORT=3000
NODE_ENV=development
# Create a dedicated Supabase project for SkillNic.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-side secret only. Never expose this value in the browser, GPT instructions, or Git.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Comma-separated exact origins if using browser clients. Leave blank to disable browser CORS origins.
CORS_ORIGINS=
